[Unit]
Description=Expes API (FastAPI + Uvicorn)
After=network.target mongod.service redis-server.service
Wants=mongod.service redis-server.service

[Service]
Type=exec
User=root
Group=root

# Папка с Pipfile и кодом бэкенда на сервере.
# Приложение само читает .env отсюда (pydantic-settings), отдельный EnvironmentFile не нужен.
WorkingDirectory=/home/expes/backend

# Прямой вызов uvicorn из venv (backend/.venv) — надёжнее, чем pipenv в рантайме.
# venv создаётся один раз: PIPENV_VENV_IN_PROJECT=1 pipenv install --python 3.11
ExecStart=/home/expes/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8011 --workers 2 --proxy-headers --forwarded-allow-ips=*

Restart=always
RestartSec=3
# Чуть больше времени на корректную остановку воркеров
TimeoutStopSec=20
KillMode=mixed

# Логи уходят в journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=expes-backend

[Install]
WantedBy=multi-user.target
